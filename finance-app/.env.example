# Copy to .env and fill in. .env is gitignored.
# This file (finance-app/.env) is read by src/config.py — Python-side secrets.
# Bank credentials live in scrape/.env, not here.

# --- Firebase service account ---
# Optional: leave blank if you keep credentials in .streamlit/secrets.toml (recommended).
# To use this instead, paste the entire service-account JSON as a single line.
GCP_SERVICE_ACCOUNT_JSON=

# --- Gemini API ---
# Optional: leave blank if you keep it in .streamlit/secrets.toml.
GEMINI_API_KEY=

# --- User profile (mirrors st.secrets.user_profile) ---
# JSON values are single-quoted so python-dotenv doesn't try to parse the brackets.
# JSON: {"<card_substr>": "<spender>", ...}
CARD_PATTERNS_JSON='{}'
# JSON: ["Joint", "Dmitry", "Yaara"]
SPENDER_NAMES_JSON='["Joint"]'
USER_CONTEXT=

# --- Notifications ---
# Configure either or both. Both fire if both are set.

# Telegram (recommended for personal use)
# 1. Talk to @BotFather, /newbot, copy the token
# 2. Message your bot once, then visit https://api.telegram.org/bot<TOKEN>/getUpdates to find chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP (alternative or in addition to Telegram)
# Generate app password at https://myaccount.google.com/apppasswords (requires 2FA).
# 16 chars, NO SPACES (Google shows it space-separated for readability — strip the spaces).
SMTP_USER=simondmitri.pr@gmail.com
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
NOTIFY_FROM_NAME=Finance Tracker Bot
# Comma-separated. Add Yaara's email once confirmed.
SUMMARY_RECIPIENTS=simondmitri.pr@gmail.com
